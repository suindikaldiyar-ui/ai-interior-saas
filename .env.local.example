# ─────────────────────────  Gemini  ─────────────────────────

# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...


# Текст и зрение: расстановка мебели, анализ фото, правки состава кухни
GEMINI_MODEL=gemini-3.6-flash

# Модель для фотореалистичного рендера
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

NEXT_PUBLIC_APP_NAME=InteriorAI Studio

# ─────────────────────────  Supabase (фаза 3)  ─────────────────────────
# Без этих ключей студия, чат и рендер по стилям работают,
# а каталог, проекты и кабинет клиента — нет.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Сервисный ключ. НИКОГДА не префиксовать NEXT_PUBLIC_ — он даёт полный обход RLS.
# Нужен для: создания первой организации, чтения /p/[token], отметки «нравится».
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─────────────────────────  White-label  ─────────────────────────
# Корневые домены, у которых поддомен — это слаг арендатора.
# decofasa.interiorai.kz → org со slug=decofasa
NEXT_PUBLIC_ROOT_DOMAIN=interiorai.kz

# ─────────────────────────  Уведомления  ─────────────────────────
# Клиент нажал «нравится» — менеджер узнаёт сразу. Необязательно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
